# ─────────────────────────────────────────────────────────
# Firewatch EDR — Configuration
# Copy this file to .env and edit the values below.
# The only REQUIRED field is ANTHROPIC_API_KEY.
# ─────────────────────────────────────────────────────────

# AI Engine (required)
ANTHROPIC_API_KEY=sk-ant-...

# Web interface port (default: 80)
PORT=80

# Database password (auto-generated on first run is fine for local use)
DB_PASSWORD=firewatch_secret

# JWT secret — change this in production
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
